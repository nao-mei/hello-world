---
// Generic illustration: people and AI each add pieces to the same structure. Says nothing about any engagement.
const cols = 4;
const rows = 3;
const size = 40;
const gap = 8;
const x0 = 188;
const y0 = 82;
const blocks = [] as { x: number; y: number; from: 'people' | 'ai'; d: number }[];
for (let c = 0; c < cols; c++) {
  for (let r = 0; r < rows; r++) {
    const from = c < 2 ? 'people' : 'ai';
    // Pieces arrive from the nearer side first, working inwards.
    const steps = from === 'people' ? c : cols - 1 - c;
    blocks.push({ x: x0 + c * (size + gap), y: y0 + r * (size + gap), from, d: +(steps * 0.7 + r * 0.25).toFixed(2) });
  }
}
---

<svg viewBox="0 0 560 305" role="img" aria-labelledby="d2t d2d" class="build-fig">
  <title id="d2t">Build it with people</title>
  <desc id="d2d">A person on the left and an AI on the right each add square pieces from their own side. The pieces meet in the middle and fit together into one structure, built by both.</desc>
  <circle cx="64" cy="150" r="22" class="shp" />
  <circle cx="64" cy="143" r="6" class="ln" /><path d="M52 160 C54 150 74 150 76 160" class="ln" />
  <text x="64" y="198" text-anchor="middle" class="sm">people</text>
  <rect x="478" y="128" width="44" height="44" class="shp" />
  <path d="M488 140 H512 M488 150 H512 M488 160 H504" class="ln thin" />
  <text x="500" y="198" text-anchor="middle" class="sm">AI</text>
  <path d="M90 150 H182" class="ln thin" stroke-dasharray="3 5" />
  <path d="M474 150 H378" class="ln thin" stroke-dasharray="3 5" />
  {
    blocks.map((b) => (
      <rect x={b.x} y={b.y} width={size} height={size} class={`blk ${b.from}`} style={`--d:${b.d}s`} />
    ))
  }
  <text x="280" y="248" text-anchor="middle" class="sm">built together</text>
  <g class="mk"><circle cx="64" cy="108" r="9" /><text x="64" y="111.5">1</text></g>
  <g class="mk"><circle cx="280" cy="62" r="9" /><text x="280" y="65.5">2</text></g>
  <g class="mk"><circle cx="500" cy="108" r="9" /><text x="500" y="111.5">3</text></g>
</svg>
<ol class="steps">
  <li><b>1</b> People bring the understanding</li>
  <li><b>2</b> Pieces fit together</li>
  <li><b>3</b> AI adds speed and reach</li>
</ol>

<style>
  .blk { fill: color-mix(in srgb, var(--accent) 22%, var(--surface)); stroke-width: 1.3; stroke-linejoin: round; }
  .blk.people { stroke: var(--accent3); }
  .blk.ai { stroke: var(--accent2); }
  @media (prefers-reduced-motion: no-preference) {
    .blk { animation: place 8s ease-in-out infinite; animation-delay: var(--d); transform-box: fill-box; transform-origin: center; }
    @keyframes place {
      0% { opacity: 0.12; transform: scale(0.6); fill: var(--surface); }
      8% { opacity: 1; transform: scale(1.06); fill: var(--accent); }
      14%, 82% { opacity: 1; transform: scale(1); fill: color-mix(in srgb, var(--accent) 22%, var(--surface)); }
      94%, 100% { opacity: 0.12; transform: scale(0.6); fill: var(--surface); }
    }
  }
</style>
