---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/inter';
import '../styles/global.css';
import { getCollection } from 'astro:content';
import Palette from '../islands/Palette.svelte';

interface Props {
  title: string;
  description?: string | undefined;
}
const { title, description = 'Naomei Cathcart: ideas, AI and people. I help teams change how they work, with technology, AI and people in mind.' } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fullTitle = title === 'Naomei Cathcart' ? title : `${title} · Naomei Cathcart`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og.png`, Astro.site).href : undefined;
const nav = [
  { label: 'Home', href: `${base}/` },
  { label: 'Every angle', href: `${base}/career/` },
  { label: 'Build it', href: `${base}/making/` },
  { label: 'Minds', href: `${base}/minds/` },
];
const links = await getCollection('links');
const commands = await getCollection('commands');
const hello = links.find((l) => l.id === 'linkedin');
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const norm = (t: string) => t.trim().toLowerCase().replace(/\s+/g, ' ');

const linkItem = (l: (typeof links)[number]) => ({
  id: `link-${l.id}`,
  label: l.data.label,
  hint: 'link',
  href: l.data.href,
  external: l.data.href.startsWith('http'),
});
// Things you can't already reach from the header come first; page navigation is a convenience at the end.
const items = [
  { id: 'ask', label: 'Ask me something', hint: 'quick answers', href: '', action: 'ask' as const },
  ...links.filter((l) => l.data.kind === 'contact').map(linkItem),
  ...projects.map((p) => ({ id: `project-${p.id}`, label: p.data.title, hint: 'made with AI', href: `${base}/making/${p.data.case}/` })),
  ...nav.map((n) => ({ id: `nav-${n.label.toLowerCase()}`, label: `Go to ${n.label}`, hint: 'page', href: n.href })),
  ...links.filter((l) => l.data.kind !== 'contact').map(linkItem),
];
// Quick answers (listed under "Ask me something"). Hidden ones, and the terminal-style aliases, only match when typed.
// Drop the leading blank line and trailing space, but keep leading spaces (ASCII art depends on them).
const tidy = (t: string) => t.replace(/^\s*\n/, '').trimEnd();
const answer = (c: (typeof commands)[number]) => ({ id: `ask-${c.id}`, label: c.data.name, hint: 'answer', href: '', output: tidy(c.data.output), art: c.data.art, link: c.data.href });
const visible = commands.filter((c) => !c.data.hidden);
const ask = visible.filter((c) => c.data.group === 'main').map(answer);
// Behind the "More" button: the rest of the questions, then the fun ones.
const more = [...visible.filter((c) => c.data.group === 'more'), ...visible.filter((c) => c.data.group === 'fun')].map(answer);
// Everything, including the secret ones, can be typed.
const typed = commands.map((c) => ({ names: [c.data.name, ...c.data.aliases].map(norm), keywords: c.data.keywords, label: c.data.name, output: tidy(c.data.output), art: c.data.art, link: c.data.href }));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Unlisted: reachable by link, kept out of search engines. Remove this line to allow indexing. -->
    <meta name="robots" content="noindex" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:alt" content="The name Naomei Cathcart in blue dots, beside a circle, a square and a triangle drawn as one three-dimensional object." />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="color-scheme" content="dark light" />
    <script is:inline>
      try { if (localStorage.getItem("theme") === "light") document.documentElement.dataset.theme = "light"; } catch (e) {}
    </script>
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
      <div class="wrap">
        <nav aria-label="Main">
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
          {links.filter((l) => l.data.kind !== 'contact' && l.id !== 'linkedin').map((l) => <a href={l.data.href} target="_blank" rel="noopener noreferrer">{l.data.label}</a>)}
        </nav>
        <button type="button" class="theme-toggle" hidden aria-pressed="false">Light mode</button>
        <Palette client:only="svelte" items={items} ask={ask} more={more} typed={typed} />
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        {hello && <span>Say hello: <a href={hello.data.href} target="_blank" rel="noopener noreferrer">LinkedIn<span class="sr"> (opens in a new tab)</span> ↗</a></span>}
        <a class="totop" href="#">↑ Back to top</a>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var btn = document.querySelector('.theme-toggle');
        if (!btn) return;
        var root = document.documentElement;
        function paint() {
          var light = root.dataset.theme === 'light';
          btn.textContent = light ? 'Dark mode' : 'Light mode';
          btn.setAttribute('aria-pressed', String(light));
        }
        btn.hidden = false;
        paint();
        btn.addEventListener('click', function () {
          var light = root.dataset.theme !== 'light';
          if (light) root.dataset.theme = 'light'; else delete root.dataset.theme;
          try { localStorage.setItem('theme', light ? 'light' : 'dark'); } catch (e) {}
          paint();
          window.dispatchEvent(new Event('themechange'));
        });
      })();
    </script>
  </body>
</html>
